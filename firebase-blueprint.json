{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["instructor", "apprentice"] },
        "apprenticeData": { "type": "object" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    }
  }
}
